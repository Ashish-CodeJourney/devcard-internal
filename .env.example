# ─── Database ───
DATABASE_URL=postgresql://devcard:devcard@localhost:5432/devcard?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Set The Url ───
PUBLIC_APP_URL=https://dev-card-nine.vercel.app

# ─── JWT ───
# JWT_SECRET: any long random string, minimum 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── Encryption (for OAuth tokens) ───
# ENCRYPTION_KEY: must be exactly 32 bytes = 64 hex characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ─── GitHub OAuth ───
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Platform-link verification providers ───
# Each is optional: a provider stays hidden until both values are set.
# Discord:  redirect URI -> ${BACKEND_URL}/api/verify/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GitLab:   redirect URI -> ${BACKEND_URL}/api/verify/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# LinkedIn: redirect URI -> ${BACKEND_URL}/api/verify/linkedin/callback
#           (requires LinkedIn app review before it can be used)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Comma-separated emails allowed to moderate events without a DB role change.
ADMIN_EMAILS=

# ─── App URLs ───
PUBLIC_APP_URL=https://dev-card-nine.vercel.app
BACKEND_URL=https://devcard-internal-backend.onrender.com
MOBILE_REDIRECT_URI=devcard://oauth/callback

# ─── Server ───
PORT=3000
NODE_ENV=production

# ─── Refresh Token Cleanup ───
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=86400000
